{
  "name": "beauty-clinic-api-v1",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Secure Node.js/Express/MySQL API for a beauty clinic website and admin panel",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "check": "node --check src/server.js && node --check src/app.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "sharp": "^0.34.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "cross-env": "^10.0.0",
    "jest": "^30.0.0",
    "supertest": "^7.1.1"
  }
}
